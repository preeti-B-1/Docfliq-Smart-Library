# ============================================================
# DocFliq Smart Library — FastAPI Backend Environment Variables
# Copy this file to backend/.env and fill in values
# ============================================================

# --------------------------------------------------
# Database (Supabase PostgreSQL)
# Find in: Supabase project > Settings > Database > Connection string
# Use the "URI" format (mode: session recommended for FastAPI)
# --------------------------------------------------
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# --------------------------------------------------
# JWT Authentication
# Must match NEXTAUTH_SECRET set in the frontend
# --------------------------------------------------
JWT_SECRET=

# --------------------------------------------------
# Admin
# --------------------------------------------------
ADMIN_EMAIL=

# --------------------------------------------------
# Anthropic / Claude API
# Get your key at https://console.anthropic.com
# --------------------------------------------------
ANTHROPIC_API_KEY=

# --------------------------------------------------
# OpenAI API (used for text-embedding-3-small)
# Get your key at https://platform.openai.com/api-keys
# --------------------------------------------------
OPENAI_API_KEY=

# --------------------------------------------------
# CORS
# Comma-separated list of allowed frontend origins
# Local: http://localhost:3000
# Production: https://your-app.vercel.app
# --------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000
