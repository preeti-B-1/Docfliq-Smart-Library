# ============================================================
# DocFliq Smart Library — Next.js Frontend Environment Variables
# Copy this file to frontend/.env.local and fill in values
# ============================================================

# --------------------------------------------------
# NextAuth.js
# --------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# The canonical URL of your deployed frontend (no trailing slash)
# Local: http://localhost:3000
# Production: https://your-app.vercel.app
NEXTAUTH_URL=

# --------------------------------------------------
# Google OAuth (via NextAuth.js)
# Create credentials at https://console.developers.google.com
# --------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --------------------------------------------------
# Backend API
# --------------------------------------------------
# Local: http://localhost:8000
# Production: https://your-backend.onrender.com
NEXT_PUBLIC_API_URL=

# --------------------------------------------------
# Admin
# --------------------------------------------------
# The single admin email address — must match ADMIN_EMAIL in backend
ADMIN_EMAIL=
